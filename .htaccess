Options -Indexes

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^\.env - [F,L]
    RewriteRule ^(app|routes)(/|$) - [F,L]

    # Encaminha /config para a aplicação
    RewriteRule ^config(/|$) public/index.php [L,QSA]

    # Encaminha os demais acessos para public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>