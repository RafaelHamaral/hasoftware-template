DB_HOST=localhost
DB_NAME=seu_banco
DB_USER=seu_usuario
DB_PASS=
DB_CHARSET=utf8mb4


# Seeders (php bin/seed.php run) — preencha só no .env local, nunca no Git.
# SEED_ADMIN_NAME=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# APP_ENV=local
# SEED_ALLOW_DEMO=

# Remetente autorizado (não use o Outlook como From).
# Destinatário (To): Área Restrita → Dados de contato → E-mail de notificação.
# MAIL_FROM=noreply@seudominio.com
# MAIL_FROM_NAME=H. A Consultoria
# MAIL_TRANSPORT=log
# MAIL_TRANSPORT=fail
# MAIL_TRANSPORT=mail
#
# InfinityFree (plano gratuito): mail() é bloqueado. Para chegar ao Outlook,
# use SMTP externo na porta 587 (Brevo, SMTP2GO ou o exemplo PHPMailer da InfinityFree)
# e coloque as credenciais só no .env — ainda não implementado neste código.
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
